							"script": {
								"exec": [
									"// Test Short Base64 Password decoded.",
									"// This check is performed at the \"RegistrationController.java\" level ",
									"// after bypassing the Jakarta Validation check in the ",
									"// \"RegisterDTORequest.java\" file.",
									"// Note: \"c2hvcnQ=\" is Base64 for \"short\".",
									"pm.test(\"It should PASS if the base64 password after decoding is less than 6 characters!\", function(){",
									"    pm.expect(pm.response.code).to.eql(400);",
