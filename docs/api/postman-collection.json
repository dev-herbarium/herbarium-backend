					"name": "1. User Registration 1o10 Success [201 Created][Herbarium]",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// This test is performed at the level of the \"RegisterController.java\".",
									"pm.test(\"Successful POST request\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"",
									"    var jsonData = {};",
									"",
									"    try {",
									"        jsonData = pm.response.json();",
									"    } catch (error) {",
									"        // If response is not a JSON, fail the test:",
									"        pm.expect.fail('Response is not valid JSON: ' + error);",
									"    }",
									"    ",
									"    // Check JSON properties to have the expected values:",
									"    pm.expect(jsonData).to.have.property('message', 'User registered successfully');",
									"    pm.expect(jsonData).to.have.property('email', 'test@herbarium.com');",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@herbarium.com\",\n    \"password\": \"c2VjcmV0MTIz\",\n    \"confirmPassword\": \"c2VjcmV0MTIz\"\n}",
